{
  "name": "shortage-watch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build-sample": "tsx scripts/build-sample-hospital.ts",
    "typecheck": "tsc --noEmit",
    "zetaris:setup": "tsx scripts/zetaris-setup.ts",
    "zetaris:check": "tsx scripts/zetaris-check.ts",
    "meterless:check": "tsx scripts/meterless-check.ts",
    "agent": "tsx scripts/run-agent.ts",
    "test": "vitest run",
    "hmem:conformance": "HMEM_IMPL=$PWD/vendor/meterless-hmem/src/index.ts tsx vendor/meterless-hmem/conformance/runner.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "serve": "tsx src/server.ts",
    "start": "npm run web:build && npm run serve"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7"
  }
}
