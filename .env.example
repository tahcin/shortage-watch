# Copy to .env and fill in. Never commit .env.

# Zetaris (local install: REST API on port 8888, organisation id 1, API key from Management > API Tokens)
ZETARIS_REST_URL=http://127.0.0.1:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# Meterless Nightshift: the primary AI provider (Console > API key). Model ids are Meterless routing modes.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL_FAST=meterless/fast
METERLESS_MODEL_DEEP=meterless/deep

# Optional explicit fallback only (LLM_PROVIDER=nvidia): NVIDIA API catalog, Nemotron models
LLM_PROVIDER=meterless
NVIDIA_API_KEY=your-nvidia-api-key

# Sample hospital database (infra/hospital-db)
HOSPITAL_DB_PASSWORD=change-me

# Set to true to replay recorded Zetaris results and model replies (no credentials needed)
SAMPLE_MODE=false
